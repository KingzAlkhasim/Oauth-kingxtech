VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Vercel-hosted KX-NeuroCore backend. Keep this URL public; never put API keys here.
# Example: https://kx-neurocore.vercel.app
VITE_API_BASE_URL=

# Optional — Billing page shows an honest "not configured" state if these are left blank.
# LemonSqueezy: your hosted checkout URL for the $20/mo Pro Plan product/variant.
VITE_LEMONSQUEEZY_CHECKOUT_URL=
# Paystack: your hosted payment page URL (or Paystack Plans checkout link).
VITE_PAYSTACK_CHECKOUT_URL=
