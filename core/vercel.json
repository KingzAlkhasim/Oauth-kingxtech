{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.ts": {
      "maxDuration": 300,
      "includeFiles": "node_modules/**"
    }
  },
  "crons": [
    {
      "path": "/api/internal/cron/expire-plans",
      "schedule": "0 3 * * *"
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ]
}
